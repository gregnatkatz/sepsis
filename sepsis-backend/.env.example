# Azure Authentication
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Model Deployments
AZURE_OPENAI_DEPLOYMENT_O1=o1
AZURE_OPENAI_DEPLOYMENT_O3=o3
AZURE_OPENAI_DEPLOYMENT_O4_MINI=o4-mini
AZURE_OPENAI_DEPLOYMENT_GPT41=gpt-4.1
AZURE_OPENAI_DEPLOYMENT_GPT41_MINI=gpt-4.1-mini
AZURE_OPENAI_DEPLOYMENT_GPT41_NANO=gpt-4.1-nano
AZURE_OPENAI_DEPLOYMENT_DEEPSEEK=DeepSeek-V3-0324
AZURE_OPENAI_DEPLOYMENT_NAME=o3

# Model-specific endpoints and keys
# O3 Model
O3_ENDPOINT=https://your-resource.cognitiveservices.azure.com/openai/deployments/o3/chat/completions?api-version=2025-01-01-preview
O3_API_KEY=your-o3-api-key

# O1 Model
O1_ENDPOINT=https://your-resource.cognitiveservices.azure.com/openai/deployments/o1/chat/completions?api-version=2025-01-01-preview
O1_API_KEY=your-o1-api-key

# O4-Mini Model
O4_MINI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/openai/deployments/o4-mini/chat/completions?api-version=2025-01-01-preview
O4_MINI_API_KEY=your-o4-mini-api-key

# GPT-4.1 Models
GPT41_ENDPOINT=https://your-resource.cognitiveservices.azure.com/openai/deployments/gpt-4.1/chat/completions?api-version=2025-01-01-preview
GPT41_API_KEY=your-gpt41-api-key
GPT41_MINI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/openai/deployments/gpt-4.1-mini/chat/completions?api-version=2025-01-01-preview
GPT41_MINI_API_KEY=your-gpt41-mini-api-key
GPT41_NANO_ENDPOINT=https://your-resource.cognitiveservices.azure.com/openai/deployments/gpt-4.1-nano/chat/completions?api-version=2025-01-01-preview
GPT41_NANO_API_KEY=your-gpt41-nano-api-key

# GPT-5 Models
GPT5_ENDPOINT=https://your-resource.cognitiveservices.azure.com/openai/deployments/gpt-5/chat/completions?api-version=2025-01-01-preview
GPT5_API_KEY=your-gpt5-api-key
GPT5_CHAT_ENDPOINT=https://your-resource.cognitiveservices.azure.com/openai/deployments/gpt-5-chat/chat/completions?api-version=2025-01-01-preview
GPT5_CHAT_API_KEY=your-gpt5-chat-api-key
MODEL_ROUTER_ENDPOINT=https://your-resource.cognitiveservices.azure.com/openai/deployments/model-router/chat/completions?api-version=2025-01-01-preview
MODEL_ROUTER_API_KEY=your-model-router-api-key

# Default Model Selection (can be changed to gpt-5, gpt-5-chat, model-router, o3, deepseek, etc.)
DEFAULT_MODEL=model-router

# Deepseek Configuration
DEEPSEEK_ENDPOINT=https://your-resource.services.ai.azure.com/models/chat/completions?api-version=2024-05-01-preview
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_DEPLOYMENT_NAME=DeepSeek-V3-0324

# Azure AI Foundry Configuration
FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_PROJECT_ID=your-project-id
AZURE_SUBSCRIPTION_ID=your-subscription-id
FOUNDRY_API_KEY=your-foundry-api-key
GPT41_DEPLOYMENT_NAME=gpt-4.1

# Azure Agents
STAKEHOLDER_MAPPER=Stakeholder-Mapper
STAKEHOLDER_MAPPER_AGENT_ID=your-stakeholder-mapper-agent-id
MSX_GAP_ANALYZER=MSX-Gap-Analyzer
MSX_GAP_ANALYZER_AGENT_ID=your-msx-gap-analyzer-agent-id
PORTFOLIO_TEXT_PROCESSOR=Portfolio-Text-Processor
PORTFOLIO_TEXT_PROCESSOR_AGENT_ID=your-portfolio-text-processor-agent-id

# Application Insights Configuration (for Azure AI Foundry observability)
APPLICATIONINSIGHTS_CONNECTION_STRING=your-application-insights-connection-string
DATABASE_URL=sqlite+aiosqlite:///./engagement_tracker.db

# Azure OpenAI Realtime API Configuration
AZURE_OPENAI_REALTIME_ENDPOINT=https://your-resource.cognitiveservices.azure.com/openai/realtime?api-version=2024-10-01-preview&deployment=gpt-realtime-mini
AZURE_OPENAI_REALTIME_API_KEY=your-realtime-api-key
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-mini
