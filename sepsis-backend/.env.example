# Azure OpenAI Configuration
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Azure OpenAI Endpoint
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com

# GPT-4.1 Configuration
GPT41_API_KEY=your-gpt41-api-key
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Azure OpenAI Realtime API Configuration
AZURE_OPENAI_REALTIME_ENDPOINT=https://your-resource.cognitiveservices.azure.com/openai/realtime?api-version=2024-10-01-preview&deployment=gpt-realtime-mini
AZURE_OPENAI_REALTIME_API_KEY=your-realtime-api-key
